{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "resolveJsonModule": true
  },
  "include": [
    "agents/**/*",
    "ingestion/**/*",
    "demo-app/**/*",
    "generated-tests/**/*"
  ],
  "exclude": ["node_modules", "dashboard"]
}
